{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Une commande passée sur NumsGames pour une calculatrice NumWorks",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique de la commande"
        },
        "ticketId": {
          "type": "string",
          "description": "Numéro de ticket court ex: NG-1234"
        },
        "categoryTitle": {
          "type": "string",
          "description": "Titre de la catégorie commandée"
        },
        "prenom": {
          "type": "string",
          "description": "Prénom du client"
        },
        "nom": {
          "type": "string",
          "description": "Nom du client"
        },
        "items": {
          "type": "array",
          "description": "Liste des noms de jeux ou logiciels commandés"
        },
        "demandeLibre": {
          "type": "string",
          "description": "Précisions ou demandes libres éventuelles"
        },
        "totalPrice": {
          "type": "string",
          "description": "Prix total calculé"
        },
        "date": {
          "type": "string",
          "description": "Date lisible de commande"
        },
        "status": {
          "type": "string",
          "enum": ["En attente", "Prêt", "Terminé"],
          "description": "Statut de la commande"
        },
        "telegramSent": {
          "type": "boolean",
          "description": "Indique si la notification Telegram a été transmise avec succès"
        }
      },
      "required": [
        "ticketId",
        "categoryTitle",
        "prenom",
        "nom",
        "items",
        "totalPrice",
        "status"
      ]
    },
    "NotificationSetting": {
      "title": "NotificationSetting",
      "description": "Paramètres de notification Telegram et alertes pour l'administrateur",
      "type": "object",
      "properties": {
        "telegramToken": {
          "type": "string",
          "description": "Token sécurisé du bot Telegram"
        },
        "telegramChatId": {
          "type": "string",
          "description": "Chat ID Telegram de Roman"
        },
        "web3formsKey": {
          "type": "string",
          "description": "Clé Web3Forms pour les e-mails"
        },
        "updatedAt": {
          "type": "string",
          "description": "Date de mise à jour"
        }
      }
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection globale des commandes synchronisées entre téléphone et PC"
    },
    "/settings/{settingId}": {
      "schema": "NotificationSetting",
      "description": "Configuration des notifications et alertes"
    }
  }
}

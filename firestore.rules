rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['ticketId', 'categoryTitle', 'prenom', 'nom', 'items', 'totalPrice', 'status'])
        && data.ticketId is string && data.ticketId.size() > 0 && data.ticketId.size() <= 32
        && data.categoryTitle is string && data.categoryTitle.size() > 0 && data.categoryTitle.size() <= 100
        && data.prenom is string && data.prenom.size() > 0 && data.prenom.size() <= 100
        && data.nom is string && data.nom.size() > 0 && data.nom.size() <= 100
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalPrice is string && data.totalPrice.size() > 0 && data.totalPrice.size() <= 100
        && data.status is string && (data.status == 'En attente' || data.status == 'Prêt' || data.status == 'Terminé')
        && (!('demandeLibre' in data) || (data.demandeLibre is string && data.demandeLibre.size() <= 1000))
        && (!('date' in data) || (data.date is string && data.date.size() <= 100))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('telegramSent' in data) || (data.telegramSent is bool));
    }

    function isValidSetting(data) {
      return (!('telegramToken' in data) || (data.telegramToken is string && data.telegramToken.size() <= 200))
        && (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 100))
        && (!('web3formsKey' in data) || (data.web3formsKey is string && data.web3formsKey.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow delete: if isValidId(orderId);
    }

    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create: if isValidId(settingId) && isValidSetting(request.resource.data);
      allow update: if isValidId(settingId) && isValidSetting(request.resource.data);
      allow delete: if isValidId(settingId);
    }
  }
}
